{
  "name": "converta",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p packages/core/tsconfig.json",
    "lint": "oxlint . && eslint . --max-warnings 0",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test:coverage && bun run build && bun run test:browser",
    "postinstall": "bun scripts/prepare-engines.ts",
    "social:render": "bun scripts/render-social.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@jsquash/avif": "^2.1.1",
    "@mediabunny/aac-encoder": "^1.61.6",
    "@mediabunny/flac-encoder": "^1.61.6",
    "@mediabunny/mp3-encoder": "^1.61.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "heic2any": "^0.0.4",
    "i18next": "^26.5.3",
    "jotai": "^3.0.1",
    "lucide-react": "^1.60.0",
    "mediabunny": "^1.61.6",
    "motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "utif": "^3.1.0",
    "virtua": "^0.53.5"
  },
  "devDependencies": {
    "@converta/core": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/utif": "^3.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
